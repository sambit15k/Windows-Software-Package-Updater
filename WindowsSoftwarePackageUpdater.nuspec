<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>WindowsSoftwarePackageUpdater</id>
    <version>2.2.0</version>
    <authors>sambit15k</authors>
    <owners>sambit15k</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Enterprise-grade Windows software update utility using Winget.</description>
    <releaseNotes>
      * Feat: Add -DryRun, -SkipWinget, -SkipChocolatey, -KeepLogs switches
      * Feat: JSONC exclusions file with comment support (// and /* */)
      * Feat: Installer output now fully captured in log file
      * Feat: Formatted summary table at end of run (Manager/Name/From/To/Result)
      * Feat: Log rotation - auto-delete logs older than N days
      * Fix: Retry logic extended to Chocolatey (was Winget-only)
      * Fix: Winget availability check added (graceful skip if not found)
      * Fix: UInt32 overflow when formatting negative exit codes as hex
      * Fix: $WingetAcceptFlags converted to proper array
    </releaseNotes>
    <tags>powershell winget updater automation</tags>
    <repository type="git" url="https://github.com/sambit15k/Windows-Software-Package-Updater" />
  </metadata>
  <files>
    <file src="Update-InstalledPackages.ps1" target="content\Update-InstalledPackages.ps1" />
    <file src="README.md" target="" />
    <file src="winget-upgrade-exclusions.jsonc" target="content\winget-upgrade-exclusions.jsonc" />
  </files>
</package>
